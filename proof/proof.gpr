--  One project holding every admitted core in this repository.
--  Switches are the factory's own (see proof/CORES.tsv for provenance).
project Proof is
   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnatU", "-gnata");
   end Compiler;
end Proof;
